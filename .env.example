# RepOS environment. Copy to .env and fill in. Never commit .env.
#
# sources.json is committed and holds slugs, names, kinds and web URLs only.
# Every connection string lives here, one per source, named after its slug:
#   REPOS_SOURCE_<SLUG>_DATABASE_URL   (slug uppercased, '-' becomes '_')
# Each must be a repos_reader credential — SELECT only (docs/REPOS_V1.md §6).
# RepOS never holds a writable credential (CLAUDE.md, hard rules).

# Port the RepOS API listens on. Default 3200.
REPOS_API_PORT=3200

# Port the RepOS web dev server listens on. Default 5173.
REPOS_WEB_PORT=5173

# Base URL the browser calls the RepOS API on.
VITE_API_BASE_URL=http://127.0.0.1:3200

# One per entry in sources.json.
REPOS_SOURCE_LEXINGTON_DATABASE_URL=postgresql://repos_reader:CHANGE_ME@127.0.0.1:5432/pathfinder
REPOS_SOURCE_PATHFINDER_DATABASE_URL=postgresql://repos_reader:CHANGE_ME@127.0.0.1:5432/pathfinder_venture
