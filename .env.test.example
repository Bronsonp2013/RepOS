# Template for .env.test, which the vitest global setup and the Playwright
# webServer entries both load. Copy to .env.test and fill in with the local
# fixture databases (see test/fixtures/pathfinder/LOCAL_DB.md, gitignored).
# .env.test is gitignored; this template is committed.

REPOS_API_PORT=3200
REPOS_WEB_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:3200

# The two configured sources, as repos_reader (SELECT only).
REPOS_SOURCE_LEXINGTON_DATABASE_URL=postgresql://repos_reader:CHANGE_ME@127.0.0.1:5432/repos_test_lexington
REPOS_SOURCE_PATHFINDER_DATABASE_URL=postgresql://repos_reader:CHANGE_ME@127.0.0.1:5432/repos_test_venture

# Test-only extras.
# A port nothing listens on, for the degradation test (C7).
REPOS_TEST_CLOSED_DATABASE_URL=postgresql://repos_reader:CHANGE_ME@127.0.0.1:59599/repos_test_venture
# The fixture owner role, for asserting repos_reader is genuinely less privileged (C3).
REPOS_TEST_OWNER_DATABASE_URL=postgresql://repos_owner@127.0.0.1:5432/repos_test_lexington
# Superuser, only so the schema test can build a throwaway database that is
# missing 0029_sessions.sql and drop it again (C4).
REPOS_TEST_SUPERUSER_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
