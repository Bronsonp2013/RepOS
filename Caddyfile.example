# Example Caddyfile for RepOS on the tailnet (docs/REPOS_V1.md §2 decision 6:
# private network only in V1, never a public URL). Copy to Caddyfile on the
# NAS, fill in the real tailnet hostname, and point `root` at the built web
# bundle. `docker compose up -d` builds it into the `web-dist` named volume
# (docker-compose.yml); find its host path with:
#   docker volume inspect <project>_web-dist --format '{{ .Mountpoint }}'
# (<project> is the compose project name, the repo directory name by
# default) and use that path below — see docs/DEPLOY.md step 4.

repos.<your-tailnet-name>.ts.net {
    # Security headers for the same-origin SPA. No external script/style/
    # frame sources are needed; the API is same-origin under /api/*.
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }

    # Static web bundle. Replace with the `web-dist` volume's Mountpoint
    # (see the header comment above).
    root * /path/to/repos_web-dist/_data
    file_server
    try_files {path} /index.html

    # RepOS API. Matches REPOS_API_PORT in .env (default 3200).
    handle /api/* {
        reverse_proxy 127.0.0.1:3200
    }
}

# --- Per-venture Pathfinder instances --------------------------------------
#
# Each Pathfinder instance RepOS reads from (docs/REPOS_V1.md §5) gets its
# own site block here too, on its own tailnet hostname and port, exactly as
# it is deployed today. RepOS only deep-links to these — `{web}/accounts/{id}`
# etc, built from each source's `webUrl` in sources.json — it never proxies
# or serves their content. Add one block per source, matching sources.json:
#
# pathfinder.<your-tailnet-name>.ts.net {
#     reverse_proxy 127.0.0.1:3000
# }
#
# pathfinder-venture.<your-tailnet-name>.ts.net {
#     reverse_proxy 127.0.0.1:3010
# }
